{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b *)",
      "Bash(git switch *)",
      "Bash(git worktree add *)",
      "Bash(git fetch*)",
      "Bash(git pull --rebase*)",
      "Bash(git rebase origin/main*)",
      "Bash(git push -u origin lane/*)",
      "Bash(git push origin lane/*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list*)",
      "Bash(gh issue view *)",
      "Bash(gh issue list*)",
      "Bash(anchor *)",
      "Bash(cargo *)",
      "Bash(pnpm *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(solana *)",
      "Bash(surfpool *)",
      "Bash(wasm-opt *)",
      "Bash(grok *)"
    ],
    "ask": [
      "Bash(gh pr merge *)",
      "Bash(git push origin main*)",
      "Bash(solana program deploy *)",
      "Bash(anchor deploy*)",
      "Bash(solana airdrop *)",
      "Edit(./.github/**)",
      "Bash(solana-keygen *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push -d*)",
      "Bash(git push * -d *)",
      "Bash(git push * :*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push --prune*)",
      "Bash(git push * --prune*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)",
      "Bash(git tag -d *)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo archive*)",
      "Bash(gh repo edit*)",
      "Bash(gh release delete*)",
      "Bash(gh issue delete*)",
      "Bash(gh label delete*)",
      "Bash(gh secret *)",
      "Bash(gh ruleset *)",
      "Bash(gh api *)",
      "Bash(rm -rf *)",
      "Bash(solana program close*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./private/keys/**)",
      "Read(**/*keypair*.json)",
      "Read(**/id.json)",
      "Read(./target/deploy/*.json)",
      "Edit(./docs/**)",
      "Edit(./.claude/settings.json)"
    ]
  }
}
