dark dark
curse curse
cold cold

# materials: primary ramp, secondary ramp, `dither` for cloth, leather, stone, plants
material steel      steel    leather
material human      skin     hair
material elf        skin_elf hair_elf
material robe       robe     leather  dither
material leather    leather  leather  dither
material cape       cape_red leather  dither
material wolf       fur      fur      dither
material goblin     green    leather
material stone      gray     gray     dither
material tile_wall   stone  gray      dither
material tile_floor  floor  stone     dither
material tile_water  water  cold
material tile_door   wood   leather   dither
# appended in palette 2
material cloth      cloth    leather  dither
material moss       moss     dirt     dither
material bone       bone     wood
material chest      wood     steel    dither
# appended in ART-3 (monsters)
material wolf_dark  fur_dark  fur_dark  dither
material goblin_dark gob_skin rag      dither
