{
  "name": "@deadroll/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sdk": "pnpm --filter @deadroll/sdk build",
    "dev": "pnpm sdk && vite",
    "dev:localnet": "pnpm sdk && vite --mode localnet",
    "dev:devnet": "pnpm sdk && vite --mode devnet",
    "build": "pnpm sdk && tsc -p . && vite build",
    "build:devnet": "pnpm sdk && tsc -p . && vite build --mode devnet",
    "preview": "vite preview",
    "preview:devnet": "vite preview --mode devnet",
    "typecheck": "pnpm sdk && tsc -p .",
    "test": "pnpm --filter @deadroll/sdk test && vitest run --passWithNoTests"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.30.1",
    "@deadroll/sdk": "workspace:*",
    "@magicblock-labs/gum-sdk": "3.0.10",
    "@solana/kit": "8.4.0",
    "@solana/kit-plugin-rpc": "0.19.0",
    "@solana/kit-plugin-wallet": "0.21.0",
    "@solana/react": "8.4.0",
    "@solana/web3.js": "1.99.0",
    "buffer": "6.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.2",
    "typescript": "~5.9.0",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
