{
  "name": "@deadroll/sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@codama/nodes-from-anchor": "1.5.6",
    "@codama/renderers-js": "2.5.0",
    "@types/node": "^22",
    "codama": "1.11.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9"
  },
  "dependencies": {
    "@solana/kit": "8.4.0",
    "@solana/program-client-core": "8.4.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "default": "./dist/registry.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "default": "./dist/render.js"
    },
    "./character": {
      "types": "./dist/character.d.ts",
      "default": "./dist/character.js"
    },
    "./items": {
      "types": "./dist/items.d.ts",
      "default": "./dist/items.js"
    },
    "./map": {
      "types": "./dist/map.d.ts",
      "default": "./dist/map.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "default": "./dist/session.js"
    },
    "./city": {
      "types": "./dist/city.d.ts",
      "default": "./dist/city.js"
    }
  },
  "files": [
    "dist",
    "idl"
  ],
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "check": "tsx scripts/check.ts",
    "build": "tsc -p .",
    "test": "tsc -p . && tsx --test test/*.test.ts"
  }
}
